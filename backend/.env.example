# Names only. Copy to .env and fill in; never commit real values.
# Path of the SQLite file (default: data/app.db inside the backend folder).
NEGOTIATION_DB=
# Comma separated browser origins allowed to call the API, e.g. http://localhost:3000
NEGOTIATION_CORS_ORIGINS=
# Name at the foot of our messages; write a line break as backslash-n.
NEGOTIATION_SIGNATURE=
